# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Owner notifications (channel TBD — email/SMS/WhatsApp)
OWNER_NOTIFICATION_EMAIL=

# Terms & Conditions version stamped onto tc_acceptances rows — bump when the
# legal text changes so old acceptances stay tied to the version they agreed to.
TERMS_VERSION=v1

# Used to build absolute URLs (Paystack callback_url, transactional email
# links, and SEO — metadataBase/canonical/sitemap/robots/JSON-LD via
# lib/utils/site-url.ts) outside a request context. Local dev: keep as
# localhost. Production (Vercel env vars): https://genieprostudios.vercel.app
# for now, https://genieprostudios.com once that domain goes live — that's
# the one place this needs to change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (owner new-booking email, customer balance reminders, auto-cancel emails)
RESEND_API_KEY=
# Resend's sandbox sender — works without a verified domain, good for local/dev.
# Replace with a real verified-domain "From" address before going to production.
RESEND_FROM_EMAIL=GenieProStudios <onboarding@resend.dev>

# Shared secret the daily cron route (app/api/cron/daily-sweep/route.ts) checks
# against the `Authorization: Bearer <value>` header on incoming requests.
CRON_SECRET=

# HMAC signing secret for the Triumph Music Global project-tracking cookie
# (lib/services/triumph-tracking-cookie.ts) — the passwordless "Find Your
# Project" flow at /triumph/track has no Supabase session to rely on, so
# this is its own trust anchor. Generate with `openssl rand -hex 32`.
TRIUMPH_TRACKING_SECRET=

# Team-known confirmation PIN required in the "Record payment" modal before
# a Triumph project's payment status can move to Deposit Paid or Fully Paid
# (lib/services/triumph-admin-actions.ts) — defaults to 123456 if unset.
# Rotate here if the code is ever shared beyond the team.
TRIUMPH_PAYMENT_CONFIRMATION_CODE=123456
